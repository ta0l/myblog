---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="我的动态" 
    description="生活动态分享"
>
  <main class="moments-container">
    <header class="page-header">
      <h1>动态</h1>
      <p>记录与分享生活点滴</p>
    </header>

    <section id="publishBox" class="publish-box" style="display: none;">
      <textarea id="contentInput" placeholder="今天想说点什么？..." rows="3"></textarea>
      
      <div id="previewArea" class="preview-grid"></div>
      
      <div class="publish-actions">
        <label for="imageInput" class="upload-btn">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>添加图片</span>
        </label>
        <input type="file" id="imageInput" accept="image/*" multiple style="display: none;" />
        
        <button id="publishBtn" class="primary-btn">发布动态</button>
      </div>
    </section>

    <section id="momentsList" class="moments-list">
      <div class="loading-state">正在加载动态...</div>
    </section>
  </main>
</Layout>

<style is:global>
  /* ====== 核心样式设计 ====== */
  .moments-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 2rem;
    color: #1a1a1a;
    margin: 0 0 0.5rem 0;
  }
  .page-header p {
    color: #666;
    margin: 0;
  }

  /* 发布区样式 */
  .publish-box {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    margin-bottom: 2rem;
    border: 1px solid #eaeaea;
  }

  textarea {
    width: 100%;
    border: none;
    resize: none;
    font-size: 1rem;
    line-height: 1.5;
    outline: none;
    color: #333;
    background: transparent;
  }

  textarea::placeholder {
    color: #aaa;
  }

  .preview-grid, .moment-images {
    display: flex;
    flex-wrap: wrap; 
    gap: 8px;
    margin-top: 1rem;
    width: 100%; /* 确保容器本身有界限 */
  }

  /* 基础方块样式（适用于 2 张图及以上，以及发布区的预览图） */
  .preview-item, .moment-img {
    width: 110px;
    height: 110px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #f0f0f0;
    flex-shrink: 0; /* 防止图片被意外挤压 */
  }

  /* * 💎 单图模式：强硬约束！ 
   * 必须同时覆盖预览区和动态列表区
   */
  .moment-images img:only-child,
  .preview-grid img:only-child {
    /* 解除正方形固定宽高 */
    width: auto;
    height: auto;
    
    /* 强硬约束最大尺寸：绝不允许超出卡片宽度，高度也限制在合理范围内 */
    max-width: 100%; 
    max-height: 400px; 
    
    /* 保持比例 */
    object-fit: contain; 
    
    /* 靠左对齐，避免看起来悬空 */
    object-position: left top; 
  }


  /* 毛玻璃半透明悬浮按钮 */
  .delete-img-btn {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    background: rgba(0, 0, 0, 0.4); /* 默认半透明黑 */
    backdrop-filter: blur(4px);     /* 毛玻璃特效 */
    -webkit-backdrop-filter: blur(4px);
    color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Q弹过渡效果 */
    z-index: 10;
  }

  /* 鼠标悬浮在按钮上时的状态 */
  .delete-img-btn:hover {
    background: rgba(220, 53, 69, 0.9); /* 变成柔和的红色 */
    color: #fff;
    transform: scale(1.15); /* 微微放大 */
  }

  .preview-wrapper {
    position: relative;
    display: inline-block;
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    border-radius: 8px; 
    overflow: hidden; /* 核心：确保悬浮按钮不会超出圆角边界 */
  }

  .preview-wrapper .preview-item {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    cursor: default;
    transition: filter 0.3s ease;
  }

  /* 鼠标悬浮在图片上时，图片微微变暗，凸显删除按钮 */
  .preview-wrapper:hover .preview-item {
    filter: brightness(0.85);
  }

  /* 操作按钮区 */
  .publish-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f0f0f0;
  }

  .upload-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #0070f3;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .upload-btn:hover { opacity: 0.8; }

  .primary-btn {
    background: #000;
    color: #fff;
    border: none;
    padding: 0.6rem 1.5rem;
    border-radius: 20px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.1s, background 0.2s;
  }
  .primary-btn:active { transform: scale(0.96); }
  .primary-btn:disabled { background: #ccc; cursor: not-allowed; }

  /* 动态卡片样式 */
  .moment-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    border: 1px solid #eaeaea;
  }
  .moment-time {
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 0.8rem;
  }
  .moment-content {
    font-size: 1rem;
    line-height: 1.6;
    color: #222;
    white-space: pre-wrap; /* 保留换行符 */
  }

  .moment-admin-actions {
    margin-top: 10px;
    display: flex;
    gap: 15px;
    border-top: 1px dashed #eee;
    padding-top: 10px;
  }
  .action-link {
    font-size: 0.85rem;
    cursor: pointer;
    color: #666;
    transition: color 0.2s;
  }
  .btn-edit:hover { color: var(--accent-color); }
  .btn-delete:hover { color: #dc3545; }
</style>

<script>
  import { checkAuth } from '../utils/auth';

  let isEditing = false;
  let editingId = null;
  let existingImages = []; // 用于存放编辑时已有的图片 URL
  let selectedFiles = [];  // 用于存放新上传的图片文件

  async function initMomentsPage() {
    const { isValid, token } = await checkAuth();
    
    // 💡 修复1：确保获取了所有必需的 DOM 元素
    const publishBox = document.getElementById('publishBox');
    const publishBtn = document.getElementById('publishBtn');
    const contentInput = document.getElementById('contentInput') as HTMLTextAreaElement;
    const imageInput = document.getElementById('imageInput') as HTMLInputElement;
    const previewArea = document.getElementById('previewArea');
    const momentsList = document.getElementById('momentsList');

    if (!momentsList) return; // 如果不在动态页，直接退出

    // 根据权限显示发布框
    if (publishBox) {
      publishBox.style.display = isValid ? 'block' : 'none';
    }

    // 💡 修复2：补全图片预览渲染逻辑（支持同时渲染已有图片和新选文件）
    // 💡 改进版：带有右上角删除按钮的渲染逻辑
    function renderPreviews() {
      if (!previewArea) return;
      previewArea.innerHTML = '';

      function createPreviewElement(imgSrc, isNewFile, onDelete) {
        const wrapper = document.createElement('div');
        wrapper.className = 'preview-wrapper';

        const img = document.createElement('img');
        img.src = imgSrc;
        img.className = 'preview-item';
        if (isNewFile) {
          img.style.border = '2px dashed #0070f3'; // 新文件蓝色虚线
          img.style.boxSizing = 'border-box';      // 确保边框不撑破容器
        }

        const delBtn = document.createElement('span');
        delBtn.className = 'delete-img-btn';
        delBtn.title = '移除此图片';
        
        // 💎 使用精致的矢量 SVG 图标替换文本
        delBtn.innerHTML = `
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        `;
        
        delBtn.onclick = onDelete;

        wrapper.appendChild(img);
        wrapper.appendChild(delBtn);
        return wrapper;
      }

      // 1. 渲染已有的云端图片（编辑模式）
      existingImages.forEach((url, index) => {
        const el = createPreviewElement(url, false, () => {
          existingImages.splice(index, 1);
          renderPreviews();
        });
        previewArea.appendChild(el);
      });

      // 2. 渲染新选择的本地文件
      selectedFiles.forEach((file, index) => {
        const el = createPreviewElement(URL.createObjectURL(file), true, () => {
          selectedFiles.splice(index, 1);
          renderPreviews();
        });
        previewArea.appendChild(el);
      });
    }

    // 监听本地文件选择
    if (imageInput) {
      imageInput.onchange = (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files) {
          const files = Array.from(target.files);
          selectedFiles = [...selectedFiles, ...files];
          renderPreviews();
        }
      };
    }

    // --- 加载列表函数 ---
    async function loadMoments() {
      try {
        const res = await fetch('/api/moments');;
        if (!res.ok) throw new Error('网络请求失败');
        const moments = await res.json();
        
        if (!moments || moments.length === 0) {
          momentsList.innerHTML = '<p style="color:#999; text-align:center;">还没有任何动态，快去发布第一条吧！</p>';
          return;
        }

        momentsList.innerHTML = moments.map(m => {
          let imgs = [];
          try { imgs = JSON.parse(m.images || '[]'); } catch(e){}

          const adminHtml = isValid ? `
            <div class="moment-admin-actions">
              <span class="action-link btn-edit" data-id="${m.id}" data-content="${encodeURIComponent(m.content)}" data-images='${m.images}'>编辑</span>
              <span class="action-link btn-delete" data-id="${m.id}">删除</span>
            </div>
          ` : '';

          const imagesHtml = imgs.length > 0 ? `
            <div class="moment-images">
              ${imgs.map((u: string) => `<img src="${u}" class="moment-img" loading="lazy" />`).join('')}
            </div>
          ` : '';

          return `
            <div class="moment-card" id="moment-${m.id}">
              <div class="moment-time">${new Date(m.created_at).toLocaleString('zh-CN', { hour12: false })}</div>
              <div class="moment-content">${escapeHTML(m.content)}</div>
              ${imagesHtml}
              ${adminHtml}
            </div>
          `;
        }).join('');
      } catch (err) {
        momentsList.innerHTML = '<p style="color:red; text-align:center;">加载动态失败</p>';
      }
    }

    // 防注入辅助函数
    function escapeHTML(str: string) {
      return str.replace(/[&<>'"]/g, 
        tag => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;'
          }[tag] || tag)
      );
    }

    // --- 监听列表点击 (处理编辑和删除) ---
    momentsList.onclick = async (e) => {
      const target = e.target as HTMLElement;
      
      // 1. 删除逻辑
      if (target.classList.contains('btn-delete')) {
        if (!confirm("确定要删除这条动态吗？删除后无法恢复。")) return;
        const id = target.dataset.id;
        try {
          const res = await fetch(`/api/moments/${id}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            loadMoments();
          } else {
            alert('删除失败');
          }
        } catch (err) {
          alert('请求出错');
        }
      }

      // 2. 编辑逻辑
      if (target.classList.contains('btn-edit')) {
        isEditing = true;
        editingId = target.dataset.id;
        
        // 恢复内容和旧图片
        contentInput.value = decodeURIComponent(target.dataset.content || '');
        try {
          existingImages = JSON.parse(target.dataset.images || '[]');
        } catch(e) {
          existingImages = [];
        }
        
        // 清空可能残留的新选文件
        selectedFiles = []; 
        
        if (publishBtn) publishBtn.textContent = '💾 保存修改';
        if (publishBox) publishBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        renderPreviews();
      }
    };

    // --- 💡 修复3：发布/保存按钮逻辑 ---
    if (publishBtn) {
      publishBtn.onclick = async () => {
        const content = contentInput.value.trim();
        if (!content && selectedFiles.length === 0 && existingImages.length === 0) {
          alert("写点内容或保留至少一张图片吧！");
          return;
        }

        publishBtn.disabled = true;
        const originalText = publishBtn.textContent;
        publishBtn.textContent = isEditing ? '保存中...' : '发布中...';

        try {
          const uploadedImageUrls = [];
          
          // 如果有新选择的文件，串行上传到 COS
          for (const file of selectedFiles) {
            const signRes = await fetch(`/api/upload-url?filename=${encodeURIComponent(file.name)}`, {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            if (!signRes.ok) throw new Error("获取上传签名失败");
            const { upload_url, read_url } = await signRes.json();

            const putRes = await fetch(upload_url, {
              method: 'PUT',
              body: file,
              headers: { 'Content-Type': file.type }
            });
            if (!putRes.ok) throw new Error("图片上传云端失败");

            uploadedImageUrls.push(read_url);
          }

          // 合并旧图片和新上传的图片
          const finalImages = [...existingImages, ...uploadedImageUrls];
          
          // 决定请求的方法和路径
          const url = isEditing 
            ? `/api/moments/${editingId}` 
            : '/api/moments';
          
          const method = isEditing ? 'PUT' : 'POST';

          const res = await fetch(url, {
            method: method,
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ content: content, images: finalImages })
          });

          if (!res.ok) throw new Error("保存数据失败");

          // 发布/修改成功，重置所有状态
          isEditing = false;
          editingId = null;
          existingImages = [];
          selectedFiles = [];
          contentInput.value = '';
          if (imageInput) imageInput.value = ''; // 清空 file input 的值
          renderPreviews();
          
          publishBtn.textContent = '发布动态';
          loadMoments();

        } catch (err) {
          alert("操作出错: " + err.message);
          publishBtn.textContent = originalText;
        } finally {
          publishBtn.disabled = false;
        }
      };
    }

    // 触发初次加载
    loadMoments();
  }

  document.addEventListener('astro:page-load', initMomentsPage);
</script>