---
import { ClientRouter } from 'astro:transitions';
// 1. 接收更多的 SEO 属性，并设置默认值
const { 
    title, 
    description = "天因你而笑 - 记录技术探索与生活点滴的博客", 
    keywords = "博客,技术分享,记录生活" 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | 天因你而笑</title>
    
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />

    <ClientRouter />
</head>
<body>
    <nav class="navbar">
        <div class="nav-content">
            <div class="nav-brand">
                <a href="/" class="logo">天因你而笑</a>
            </div>

            <div class="nav-menu">
                <a href="/" class={currentPath === '/' ? 'active' : ''}>首页</a>
                <a href="/explore" class={currentPath === '/explore' ? 'active' : ''}>分类与标签</a>
                <a href="/moments" class={currentPath === '/moments' ? 'active' : ''}>动态</a>
            </div>

            <div class="nav-actions">
                <a href="/publish" id="nav-publish-btn" class="publish-btn" style="display: none;">写文章</a>
                <button id="nav-logout-btn" class="logout-btn" style="display: none; cursor: pointer;">退出登录</button>
            </div>
        </div>
    </nav>

    <main class="main-content">
        <slot /> 
    </main>

    <div id="logout-modal" class="modal-overlay" style="display: none;">
        <div class="modal-box">
            <h3 style="margin-top:0;">准备离开了吗？</h3>
            <p style="color: #666; margin-bottom: 25px;">确定要退出管理员账号并返回访客模式吗？</p>
            <div class="modal-actions">
                <button id="modal-cancel-btn" class="modal-btn btn-cancel">取消</button>
                <button id="modal-confirm-btn" class="modal-btn btn-confirm">确定退出</button>
            </div>
        </div>
    </div>

    <div id="global-lightbox" class="lightbox-overlay" style="display: none;">
        <img id="lightbox-img" src="" alt="查看原图" />
    </div>

</body>
</html>

<style is:global>
    :root {
        --text-color: #2c3e50;
        --bg-color: #f8f9fa;
        --accent-color: #0066cc;
    }
    body { 
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; 
        background-color: var(--bg-color);
        margin: 0; padding: 0; color: var(--text-color);
    }

    /* 所有正文区域的图片鼠标手势提示 */
    main img { cursor: zoom-in; max-width: 100%; height: auto; transition: opacity 0.2s; }
    main img:hover { opacity: 0.9; }

    /* ---------------- 导航栏样式 (保留并优化) ---------------- */
    .navbar { position: sticky; top: 0; z-index: 1000; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); box-shadow: 0 1px 0 rgba(0,0,0,0.05); }
    .nav-content { max-width: 1000px; margin: 0 auto; height: 70px; padding: 0 20px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
    .nav-brand { justify-self: start; }
    .logo { text-decoration: none; font-size: 1.4em; font-weight: 800; color: #2c3e50; }
    .nav-menu { justify-self: center; display: flex; gap: 30px; }
    .nav-menu a { text-decoration: none; color: #666; font-weight: 500; padding: 8px 16px; border-radius: 8px; }
    .nav-menu a.active { color: var(--accent-color); font-weight: bold; background: rgba(0, 102, 204, 0.1); }
    .nav-actions { justify-self: end; display: flex; gap: 15px; }
    .publish-btn { background: var(--accent-color); color: white !important; padding: 8px 16px; border-radius: 20px; text-decoration: none; font-weight: bold; }
    .logout-btn { color: #dc3545; font-weight: 600; border: 1px solid rgba(220, 53, 69, 0.4); border-radius: 20px; background: transparent; padding: 7px 15px; }

    /* ---------------- 🌟 全局灯箱样式 ---------------- */
    .lightbox-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.9); backdrop-filter: blur(10px);
        z-index: 10000; display: flex; justify-content: center; align-items: center;
        cursor: zoom-out; opacity: 0; transition: opacity 0.3s ease;
    }
    .lightbox-overlay.active { opacity: 1; }
    #lightbox-img { 
        max-width: 90vw; max-height: 90vh; border-radius: 4px; 
        box-shadow: 0 0 30px rgba(0,0,0,0.5); transform: scale(0.9); transition: transform 0.3s ease;
    }
    .lightbox-overlay.active #lightbox-img { transform: scale(1); }

    /* ---------------- 退出弹窗样式 ---------------- */
    .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(8px); z-index: 9999; display: flex; justify-content: center; align-items: center; }
    .modal-box { background: white; padding: 40px; border-radius: 16px; text-align: center; max-width: 320px; }
    .modal-actions { display: flex; gap: 15px; justify-content: center; }
    .modal-btn { padding: 10px 24px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; }
    .btn-cancel { background: #f1f3f5; color: #495057; }
    .btn-confirm { background: #dc3545; color: white; }
</style>

<script>
  import { checkAuth, clearAuth } from '../utils/auth';

  // 1. 同步导航栏 UI
  async function syncNavUI() {
    const publishBtn = document.getElementById('nav-publish-btn');
    const logoutBtn = document.getElementById('nav-logout-btn');
    const { isValid } = await checkAuth();

    if (isValid) {
      if (publishBtn) publishBtn.style.display = 'inline-block';
      if (logoutBtn) logoutBtn.style.display = 'inline-block';
    } else {
      if (publishBtn) publishBtn.style.display = 'none';
      if (logoutBtn) logoutBtn.style.display = 'none';
    }
  }

  // 2. 绑定全局交互事件 (退出、灯箱)
  function bindGlobalEvents() {
    const logoutBtn = document.getElementById('nav-logout-btn');
    const modal = document.getElementById('logout-modal');
    const confirmBtn = document.getElementById('modal-confirm-btn');
    const cancelBtn = document.getElementById('modal-cancel-btn');

    const lightbox = document.getElementById('global-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');

    // --- 退出逻辑 ---
    if (logoutBtn) {
        logoutBtn.onclick = () => { if (modal) modal.style.display = 'flex'; };
    }
    if (confirmBtn) {
        confirmBtn.onclick = () => { clearAuth(); window.location.href = '/'; };
    }
    if (cancelBtn) {
        cancelBtn.onclick = () => { if (modal) modal.style.display = 'none'; };
    }

    // --- 🌟 全局灯箱点击逻辑 ---
    // 使用事件委托，监听 body 内所有 img 的点击
    document.body.onclick = (e) => {
        const target = e.target;
        
        // 如果点击的是 <main> 标签内的图片，且不是导航栏、弹窗等 UI 元素
        if (target.tagName === 'IMG' && target.closest('main') && target.id !== 'lightbox-img') {
            const src = target.getAttribute('src');
            if (lightbox && lightboxImg) {
                lightboxImg.src = src;
                lightbox.style.display = 'flex';
                setTimeout(() => lightbox.classList.add('active'), 10);
            }
        }
        
        // 如果点击的是激活状态的灯箱背景
        if (lightbox && lightbox.classList.contains('active')) {
            lightbox.classList.remove('active');
            setTimeout(() => {
                lightbox.style.display = 'none';
                if (lightboxImg) lightboxImg.src = '';
            }, 300);
        }
    };
  }

  // 监听 Astro 页面加载和过渡
  document.addEventListener('astro:page-load', () => {
    syncNavUI();
    bindGlobalEvents();
  });
</script>